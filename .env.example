# GTMstack .env  (copy to .env; .env is gitignored and never deployed).
# Everything is optional and acts as a feature flag: each capability lights up
# only when its key is present. The daily report degrades cleanly without any of
# these (GitHub + YouTube still work from any IP).

# --- Daily keyword-group report ---------------------------------------------
# Where the report is stored AND read by the in-app Reports tab. On the LIVE
# Vercel site this is REQUIRED (serverless cannot read the Mac's local files);
# set the same Neon URL here and in the Vercel project so the launchd Mac job
# and the hosted tab share one store. Without it, reports save to a local JSON
# snapshot that only the local Flask app can read.
DATABASE_URL=

# Per-group scan time budget in seconds (Carlsen clock). Default 60.
REPORT_BUDGET_S=60

# Protects POST /api/report on the public deploy. When set, the run-now call
# must send header  X-Cron-Secret: <this>.  Leave blank for local dev.
CRON_SECRET=

# --- Sentiment + company tagging (enrichment) -------------------------------
# Best quality. Either an OpenAI-compatible endpoint OR an Anthropic key; with
# neither, enrichment falls back to lexicon sentiment + "Unknown" company.
ANTHROPIC_API_KEY=
# GTMSTACK_LLM_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
# GTMSTACK_LLM_KEY=
# GTMSTACK_MODEL=

# --- Signals sources --------------------------------------------------------
# GitHub + YouTube need nothing. These widen coverage for the other sources.
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# LinkedIn + X need YOUR logged-in cookies. Easiest on macOS:
#   python connect_sources.py        (opens a browser, you log in, it fills these)
# Or paste cookies by hand from browser devtools. The Chrome profile-decrypt path
# (LINKEDIN_PROFILE_DIR / X_PROFILE_DIR) is Windows-only, so prefer the jar/env.
# Use a burner LinkedIn account; LinkedIn soft-challenges under load.
LINKEDIN_COOKIES=/Users/you/.gtmstack/li_cookies.json
# LI_AT=
# LI_JSESSIONID=
X_COOKIES=/Users/you/.gtmstack/x_cookies.json
# X_AUTH_TOKEN=
# X_CT0=
# X_PROFILE_DIR=        # Windows-only auto-decrypt; leave blank on macOS

# --- Optional: residential proxy for LinkedIn/X reliability at scale --------
# GTMSTACK_PROXIES=http://user:pass@host:port,http://user:pass@host2:port

# --- Competitive monitor (9am daily job) ------------------------------------
# Google Sheets push. Create a service account in Google Cloud Console, download
# the JSON key, and share the target sheet with the service account email.
# GOOGLE_SA_JSON=/Users/you/.gtmstack/sa_key.json
# GOOGLE_SA_KEY={"type":"service_account",...}   # paste the JSON inline instead

# Target sheet. REQUIRED to push (we never auto-create + public-share a sheet).
# Create a sheet, share it with the service-account email, and paste its URL.
# GTMSTACK_SHEET_URL=https://docs.google.com/spreadsheets/d/<ID>/edit

# Monitor tuning (all optional):
# MONITOR_BUDGET_S=240          # wall-clock budget for the whole scan
# MONITOR_ENRICH_MAX=60         # cap on rows sent to the LLM per run (rest use lexicon)
# MONITOR_POLITENESS_S=0.4      # gap between reddit sub reads
# MONITOR_MAX_SUBS=8            # subreddits searched per keyword
# MONITOR_SHEET_SAFETY=1        # keep a capped column-A dedup read for burn-in (then 0)
# MONITOR_SHEET_ROTATE_ROWS=4000  # roll a sheet tab to YYYY-MM past this many rows
# MONITOR_ALERT_EMAIL=you@co.com  # silent-zero + staleness alerts (needs RESEND_API_KEY)
# MONITOR_STALE_HOURS=26        # Vercel watchdog alarms past this age

# G2 is licensed-API only (decided): compliant scraping is blocked. G2 stays
# absent from the monitor until this key is set (no scraping fallback).
# G2_API_KEY=

# Quora discovery via a paid search API (optional, Phase-4). Without it, add
# curated question URLs to a group's quora_questions instead.
# BRAVE_SEARCH_KEY=
# BING_SEARCH_KEY=
