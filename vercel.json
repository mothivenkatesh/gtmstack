{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/transcript.py": { "maxDuration": 30, "includeFiles": "api/_*.py" },
    "api/clean.py": { "maxDuration": 60, "includeFiles": "api/_*.py" },
    "api/plays.py": { "maxDuration": 60, "includeFiles": "api/_*.py" },
    "api/signals.py": { "maxDuration": 30, "includeFiles": "api/_*.py" },
    "api/persona.py": { "includeFiles": "api/_*.py" },
    "api/jobs.py": { "includeFiles": "api/_*.py" },
    "api/report.py": { "maxDuration": 60, "includeFiles": "api/_*.py" },
    "api/monitor.py": { "maxDuration": 60, "includeFiles": "api/_*.py" },
    "api/watchdog.py": { "maxDuration": 30, "includeFiles": "api/_*.py" },
    "api/groups.py": { "includeFiles": "api/_*.py" }
  },
  "crons": [
    { "path": "/api/watchdog", "schedule": "30 9 * * *" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
