# Local secrets and config. Never commit.
.env

# Belt-and-suspenders: never commit any cookie / session export
*cookies*.json
*.session.json
.gtmstack/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Signals SQLite cache
*.db
gtmstack_signals.db

# Content-performance local snapshot store (agent 12, local-dev only)
api/_store/

# Daily-report run logs (the launchd agent logs to ~/.gtmstack/logs)
logs/
logs_local_*.txt
.venv/

.vercel
